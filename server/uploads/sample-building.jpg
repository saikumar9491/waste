<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <defs>
    <linearGradient id="sky2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#93c5fd" />
      <stop offset="100%" stop-color="#e2e8f0" />
    </linearGradient>
  </defs>
  <rect width="600" height="260" fill="url(#sky2)"/>
  <!-- Buildings -->
  <rect x="50" y="90" width="120" height="170" fill="#64748b" />
  <rect x="190" y="50" width="140" height="210" fill="#475569" />
  <rect x="350" y="110" width="110" height="150" fill="#64748b" />
  <rect x="480" y="70" width="90" height="190" fill="#334155" />
  <!-- Windows -->
  <g fill="#fef08a" opacity="0.8">
    <rect x="210" y="80" width="20" height="20" rx="3" />
    <rect x="250" y="80" width="20" height="20" rx="3" />
    <rect x="290" y="80" width="20" height="20" rx="3" />
    <rect x="210" y="120" width="20" height="20" rx="3" />
    <rect x="250" y="120" width="20" height="20" rx="3" />
    <rect x="290" y="120" width="20" height="20" rx="3" />
  </g>
  <!-- Clean Asphalt Road -->
  <rect y="260" width="600" height="140" fill="#1e293b" />
  <line x1="0" y1="330" x2="600" y2="330" stroke="#facc15" stroke-width="6" stroke-dasharray="30 20" />
  <text x="300" y="35" fill="#1e3a8a" font-size="20" font-family="sans-serif" font-weight="bold" text-anchor="middle">CITY ROAD &amp; ARCHITECTURAL BUILDING</text>
  <text x="300" y="380" fill="#cbd5e1" font-size="13" font-family="sans-serif" text-anchor="middle">Swept clean roadway • No visible litter or waste</text>
</svg>