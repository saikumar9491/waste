# WasteWise Environment Configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/wastewise_db
JWT_SECRET=wastewise_hackathon_super_secret_jwt_key_2026!
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini API key for real AI vision & classification
# If omitted, WasteWise uses its built-in Intelligent Fallback AI Engine seamlessly.
GEMINI_API_KEY=

# Optional: Cloudinary configuration for remote image hosting
# If omitted, local server storage in /uploads is used automatically.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
